/// Date dimension covering LAST_CLEARED_DATE and NEXT_CLEARING_DATE. Generated with CALENDAR over the full span of both columns. Active relationship to NEXT_CLEARING_DATE; inactive to LAST_CLEARED_DATE.
table DIM_DATE
	lineageTag: eb043c7b-03a4-4258-8e09-86c1f79321b3
	dataCategory: Time

	column Date
		isUnique
		formatString: Long Date
		lineageTag: 23dcf6a9-3f47-4d49-984d-308e45ab2924
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		lineageTag: 4b9dc227-a758-47ef-bb70-6e96a4154ac7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column 'Month Number'
		isHidden
		lineageTag: 74ee5d0e-51c1-4719-be65-6198194b083d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		lineageTag: 77190bbb-c0d8-4378-bff7-5e6e3498991c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column 'Month Year'
		lineageTag: 6a4b2aa3-645f-4745-a825-191a01138dbb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Year]
		sortByColumn: 'Year Month Sort'

	column Quarter
		lineageTag: 942834a5-3421-424c-8ab3-00d00a94bbc2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	column 'Year Month Sort'
		isHidden
		lineageTag: fe98d653-49f6-438b-9e57-e4c5fd2f6e04
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Sort]

	partition DIM_DATE = calculated
		mode: import
		source =
				VAR _minNext = CALCULATE ( MIN ( FACT_ROW_PLAN[NEXT_CLEARING_DATE] ) )
				VAR _minLast = CALCULATE ( MIN ( FACT_ROW_PLAN[LAST_CLEARED_DATE] ) )
				VAR _maxNext = CALCULATE ( MAX ( FACT_ROW_PLAN[NEXT_CLEARING_DATE] ) )
				VAR _maxLast = CALCULATE ( MAX ( FACT_ROW_PLAN[LAST_CLEARED_DATE] ) )
				VAR _min = MINX ( { _minNext, _minLast }, [Value] )
				VAR _max = MAXX ( { _maxNext, _maxLast }, [Value] )
				VAR _start = DATE ( YEAR ( _min ), 1, 1 )
				VAR _end = DATE ( YEAR ( _max ), 12, 31 )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( _start, _end ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm" ),
				    "Month Year", FORMAT ( [Date], "mmm yyyy" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)

