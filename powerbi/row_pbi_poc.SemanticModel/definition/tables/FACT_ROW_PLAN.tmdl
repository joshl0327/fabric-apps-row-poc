	partition FACT_ROW_PLAN = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database(App_SQL_Server, App_SQL_Database, [Query="SELECT feeder_id AS FEEDER_ID, vendor AS VENDOR_NAME, CAST(last_cleared_date AS date) AS LAST_CLEARED_DATE, last_work_done AS LAST_WORK_DONE, CAST(next_clearing_date AS date) AS NEXT_CLEARING_DATE, date_certainty AS DATE_CERTAINTY, planned_year AS PLANNED_YEAR, notes AS NOTES FROM dbo.ClearingPlans"])
				in
				    Source

	annotation PBI_ResultType = Table

