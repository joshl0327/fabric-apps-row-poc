{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(.venv/Scripts/python data/generate.py *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)",
      "Bash(npx rayfin *)",
      "Bash(snow *)",
      "Bash(rm *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(gh pr create *)",
      "PowerShell(npx rayfin *)",
      "PowerShell(snow *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(npx rayfin * --force*)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(npx rayfin * --force*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(./secrets/**)",
      "Read(~/.snowflake/**)"
    ]
  }
}
